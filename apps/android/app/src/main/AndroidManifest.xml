<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".HuePilotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.HuePilot"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HuePilot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- huepilot://assistant?listen=1, huepilot://scenes, huepilot://room/<id>, huepilot://cameras … (widgets, shortcuts) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="huepilot" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen widgets (Glance). Configuration activity shared by the widgets that need a room/light. -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:label="@string/widget_configure_label"
            android:theme="@style/Theme.HuePilot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.RoomsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_rooms_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rooms_info" />
        </receiver>
        <receiver
            android:name=".widget.RoomControlWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_room_control_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_room_control_info" />
        </receiver>
        <receiver
            android:name=".widget.ScenesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_scenes_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_scenes_info" />
        </receiver>
        <receiver
            android:name=".widget.HomeStatusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_home_status_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_home_status_info" />
        </receiver>
        <receiver
            android:name=".widget.LightControlWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_light_control_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_light_control_info" />
        </receiver>
        <receiver
            android:name=".widget.AssistantWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_assistant_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_assistant_info" />
        </receiver>
        <receiver
            android:name=".widget.SensorsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_sensors_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sensors_info" />
        </receiver>
        <receiver
            android:name=".widget.ColorStripWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_color_strip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_color_strip_info" />
        </receiver>
    </application>
</manifest>
