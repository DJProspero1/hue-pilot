<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:description="@string/widget_scenes_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="110dp"
    android:minHeight="120dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="120dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="360dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/widget_preview_scenes"
    android:configure="pt.prospero.huepilot.widget.WidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
