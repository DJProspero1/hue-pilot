# Copy to keystore.properties (git-ignored) to sign release builds.
# Create the keystore once:
#   keytool -genkeypair -v -keystore keystore/hue-pilot.jks -alias huepilot -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/hue-pilot.jks
storePassword=change-me
keyAlias=huepilot
keyPassword=change-me
